# Environment Configuration Template for CTS Commercial Analytics Platform
# Copy this file to .env and fill in your actual credentials

# Supabase Cloud PostgreSQL Database Configuration
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_DB_URL=postgresql://postgres:your_password@db.your-supabase-project.supabase.co:5432/postgres

# Google Gemini LLM API Configuration
GEMINI_API_KEY=your_gemini_api_key
